# CogCMS — copy to .env and fill in. Never commit .env.
PORT=3003

# Local example only. Vercel target: Atlas URI via secure provider settings.
# Use separate preview/production databases and collection-scoped runtime users.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=cms_public_demo

# Signs the cms_session cookie. At least 32 characters; generate with: openssl rand -base64 48
CMS_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Database-backed sessions and one-time admin bootstrap.
CMS_SESSION_HOURS=12
CMS_SESSION_REMEMBER_DAYS=30
CMS_SEED_ADMIN_EMAIL=admin@example.com
CMS_SEED_ADMIN_PASSWORD=
CMS_SEED_ADMIN_NAME=Administrator

# Optional comma-separated origins accepted by Next server actions behind a reverse proxy.
CMS_TRUSTED_ORIGINS=
# Leave unset on Vercel (VERCEL=1 is supplied by the platform).
# Off-platform production only: nginx must overwrite X-Real-IP and origin access must be private.
CMS_TRUST_PROXY=

# Private AWS S3 media: direct browser upload to private staging, then validated publication.
# Local development uses the SDK default credential chain; never put static keys here.
# Set all three or none (none = uploads disabled). S3_PUBLIC_URL is CloudFront/custom media origin.
S3_REGION=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
# Vercel only: required scoped OIDC role; no default-chain fallback when VERCEL=1.
# Role/trust and bucket CORS/lifecycle must be provisioned before enabling hosted uploads.
AWS_ROLE_ARN=

# Optional AI writing assistant in the blog editor: title, meta description and FAQ suggestions.
# Leave the key unset to turn suggestions off; the AI-readiness score works without it.
# Free keys: https://openrouter.ai/keys. Generating sends the draft to OpenRouter and the model's provider.
OPENROUTER_API_KEY=
# Optional: up to 3 comma-separated model ids, tried in order. Default: two tested free models, then
# openrouter/free. A small paid model answers faster and more reliably, for a fraction of a cent per request.
OPENROUTER_MODELS=

# Public origin of this app (used for absolute links in later phases).
NEXT_PUBLIC_CMS_URL=http://localhost:3003

# Migration-only inputs; not required by the running application.
SOURCE_MONGODB_URI=
RELEASE_NOTES_DIR=
WHITEPAPERS_DIR=
# Optional authoritative JSON array; overrides source FAQs and prunes stale target FAQs.
FAQ_SEED_JSON=
MIGRATION_SITE_SLUG=
MIGRATION_SITE_NAME=
MIGRATION_SITE_ORIGIN=
